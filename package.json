{
  "name": "vette",
  "version": "0.1.0",
  "description": "Zero-latency pre-install runtime interceptor and AI slopsquatting defense tool",
  "main": "dist/cli.cjs",
  "bin": {
    "vette": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "action.yml"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "node dist/cli.js vet react && node dist/cli.js scan package.json",
    "package:extension": "cd extension && npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vette-security/vette.git"
  },
  "bugs": {
    "url": "https://github.com/vette-security/vette/issues"
  },
  "homepage": "https://github.com/vette-security/vette#readme",
  "keywords": [
    "security",
    "slopsquatting",
    "npm",
    "pypi",
    "preinstall",
    "ai-hallucination",
    "supply-chain-security",
    "zero-day",
    "typosquatting"
  ],
  "author": "Vette Security <security@vette.dev>",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "@clack/prompts": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
